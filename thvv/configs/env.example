# ============================================================
# THVV — 通用配置
# ============================================================
# 使用：cp configs/env.example configs/.env，然后填写真实值
# 或直接 export 环境变量（优先级: CLI参数 > 环境变量 > .env文件）
# ============================================================

# -------- 必填：API 端点、密钥、模型名 --------
# API_URL 必须填【完整请求路径】：
#   OpenAI 协议:    https://api.xxx.com/v1/chat/completions
#   Anthropic 协议: https://api.xxx.com/v1/messages
API_URL=https://api.xxx.com/v1/chat/completions
API_KEY=your-api-key-here
MODEL_NAME=your-model

# -------- 必填：协议 --------
# openai / anthropic（perf + eval 均支持两种协议）
PROTOCOL=openai

# -------- 可选：tokenizer（perf 压测计长口径）--------
#   GLM-4/5 → zai-org/GLM-4.6  |  DeepSeek → deepseek-ai/DeepSeek-V3
#   MiniMax → MiniMaxAI/MiniMax-M2  |  Kimi → moonshotai/Kimi-K2-Thinking
#   Claude  → Xenova/gpt-4o
TOKENIZER=your-org/your-tokenizer

# -------- 可选：perf 压测参数 --------
# TEMPERATURE=0.0               # 采样温度；缺省按模型名自适应（kimi/moonshot=1.0，其余=0.0）
# CLIENT=供应商名称              # xlsx 报告署名

# -------- 可选：eval 评测参数 --------
# PROVIDER=zhipu                # 供应商名，用于产物目录命名
# JUDGE_API_KEY=sk-xxx          # hle / simple_qa 的 LLM Judge 密钥（模型与地址有默认值）
