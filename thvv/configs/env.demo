# ============================================================
# THVV — .env 演示样例（不可直接使用，仅作格式参考）
# ============================================================
# 用法：
#   cp configs/env.demo configs/.env   # 复制为真实配置
#   vim configs/.env                   # 按需修改占位值
#
# 注意：
#   - configs/.env 已在 .gitignore 中，不会进版本库
#   - 凭证字段（API_KEY 等）在报告中会自动脱敏
#   - 配置优先级：CLI 参数 > 环境变量 > configs/.env
# ============================================================

# ============ 示例 1：OpenAI 协议（默认启用）============
API_URL=https://api.openai.com/v1/chat/completions
API_KEY=sk-proj-demo1234567890abcdefghijklmnopqrst
MODEL_NAME=gpt-4o
PROTOCOL=openai
TOKENIZER=Xenova/gpt-4o

# ============ 示例 2：Anthropic 协议 ============
# 若需切换到 Anthropic，请注释掉上面 OpenAI 配置，并取消下面注释：
# API_URL=https://api.anthropic.com/v1/messages
# API_KEY=sk-ant-api03-demo1234567890abcdefghijklmnopqrstuvwx
# MODEL_NAME=claude-sonnet-4-5
# PROTOCOL=anthropic
# TOKENIZER=Xenova/claude-tokenizer
# ANTHROPIC_VERSION=2023-06-01            # Anthropic 协议版本头（部分网关要求）

# ============ 可选：perf 压测参数覆盖 ============
# MAX_TOKENS=2048                         # 单次返回最大 token 数
# STREAM=1                                # 是否流式（1=流式，0=非流式）
# BUCKETS=1k,2k,4k,8k,16k,32k,64k,128k   # 压测档位
# CONCURRENCY_LADDER=10,20,40,80,160      # 并发梯度
# BUCKET_COOLDOWN=30                      # 档位间冷却秒数

# ============ 可选：eval 评测参数覆盖 ============
# PROVIDER=openai                         # 供应商名（用于产物目录与用量上报）
# LIMIT=30                                # 每数据集样本上限（debug 用）
# REPEATS=1                               # 每题重复次数
# EVAL_BATCH_SIZE=10                      # 评测并发
# JUDGE_MODEL=gpt-4o                      # LLM Judge 模型（hle/simple_qa 必需）
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=sk-proj-demo-judge-key